# LLM_PROVIDER selects the chat model used by every agent (see
# src/data_analyst/clients/llm/factory.py). Required - one of "anthropic" or
# "azure_openai", with the matching section below filled in.
LLM_PROVIDER=

# --- anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- azure_openai ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Entra ID (Azure AD) sign-in for Power BI access ---
# Required: every /chat call needs the caller's own delegated Power BI
# tokens, not just an LLM provider - see
# src/data_analyst/clients/powerbi/auth.py's module docstring for why
# (row-level security requires a real signed-in user's token; there's no
# app-only/service-principal fallback). This app is a public client (PKCE,
# no client secret) everywhere - see that same docstring - so the Entra ID
# app registration needs:
#   - "Allow public client flows" enabled
#   - ENTRA_REDIRECT_URI registered under a public-client platform - either
#     "Single-page application" or "Mobile and desktop applications" both
#     work - NOT "Web", which is treated as confidential-client-only and
#     rejects a secret-less token exchange
#   - delegated API permissions for Power BI Service and (if you use it)
#     Power BI's remote MCP server, with admin consent granted
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

LOG_LEVEL=INFO
