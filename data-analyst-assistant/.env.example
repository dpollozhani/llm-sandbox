# LLM_PROVIDER selects the chat model used by every agent (see
# src/data_analyst/clients/llm/factory.py). Required - one of "anthropic" or
# "azure_openai", with the matching section below filled in.
LLM_PROVIDER=

# --- anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- azure_openai ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

LOG_LEVEL=INFO
